# Avivi Kitchens: design concept. Copy to .env.local and fill what you have.
# Everything is optional: without keys the site runs in demo mode and every tool still works.

# ---------------------------------------------------------------------------
# Avivi Designer (AI assistant), /api/designer
# Claude is used when ANTHROPIC_API_KEY is set (official SDK, structured output,
# server-side refusal fallbacks enabled). Otherwise OPENAI_API_KEY, otherwise demo mode.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# AI visualiser, /api/visualise (OpenAI-compatible images/edits endpoint)
# Falls back to OPENAI_API_KEY. Without a key: pre-rendered example rooms.
# Photos are processed in memory and never stored.
# ---------------------------------------------------------------------------
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024

# ---------------------------------------------------------------------------
# Leads: every form posts to /api/lead, which forwards to the CRM webhook
# (Salesforce, HubSpot, Priority, Make, Zapier...) and stores the lead.
# ---------------------------------------------------------------------------
LEAD_WEBHOOK_URL=
# Signs each webhook call: header x-avivi-signature = "sha256=" + HMAC-SHA256(raw body, secret).
LEAD_WEBHOOK_SECRET=
# Durable lead store for the inbox (Upstash Redis or Vercel KV). Without it: memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV uses these names instead (either pair works):
KV_REST_API_URL=
KV_REST_API_TOKEN=
LEADS_REDIS_KEY=avivi:leads

# ---------------------------------------------------------------------------
# Showroom inbox, /inbox
# Without INBOX_PASSWORD the inbox runs in demo mode (password: avivi-demo) and
# never shows server-stored leads. Set both in production.
# ---------------------------------------------------------------------------
INBOX_PASSWORD=
INBOX_SECRET=

# ---------------------------------------------------------------------------
# Public values (shown in the UI). Until set, the UI labels them as examples.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_TEL=
NEXT_PUBLIC_SERVICE_PHONE_DISPLAY=
NEXT_PUBLIC_SERVICE_PHONE_TEL=
# International format without +, e.g. 9725XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_EMAIL_SALES=
NEXT_PUBLIC_EMAIL_SERVICE=
NEXT_PUBLIC_EMAIL_PRO=
NEXT_PUBLIC_PRODUCTS_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# GA4 measurement ID. Loaded only after analytics consent.
NEXT_PUBLIC_GA_ID=
